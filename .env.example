# AWS Credentials (required for Bedrock Claude model)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_SESSION_TOKEN=your_session_token_if_using_temporary_credentials
AWS_DEFAULT_REGION=us-east-1

# SMTP Email Settings (optional, for sending study plans via email)
# Gmail: use App Password from https://myaccount.google.com/apppasswords
# QQ Mail: use authorization code from QQ Mail settings
# 163 Mail: use authorization code from 163 Mail settings
